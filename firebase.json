{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "metro-vehicle",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "backup_*.json",
      "*.csv",
      "database.rules.json",
      "scripts/**"
    ],
    "headers": [
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
